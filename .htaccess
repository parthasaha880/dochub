# EDAMS / DocHub — project root (.htaccess)
# Use this when the Apache DocumentRoot points at the project folder
# (not /public). Prefer pointing DocumentRoot to /public when you can.
#
# Production example: https://edams.kormo.bd

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Force HTTPS (enable on production with a valid SSL certificate)
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Block direct access to sensitive paths
    RewriteRule ^(app|bootstrap|config|database|node_modules|resources|routes|storage|tests|vendor)/ - [F,L]
    RewriteRule ^(\.env|\.env\..*|\.git|artisan|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|vite\.config\..*)$ - [F,L]

    # Send everything into /public
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Deny directory listing
Options -Indexes

# Deny access to hidden files (except this .htaccess)
<IfModule mod_authz_core.c>
    <FilesMatch "^\.">
        Require all denied
    </FilesMatch>
    <Files ".htaccess">
        Require all granted
    </Files>
</IfModule>
